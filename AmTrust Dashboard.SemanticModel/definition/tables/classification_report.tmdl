table classification_report
	lineageTag: 0fb95d77-93e5-4da5-8b99-b32fe47dad9f

	measure 'Data Sources Scanned' =
			
			CALCULATE (
			    DISTINCTCOUNT ( classification_report[datasource] ),
			    classification_report[catalog_status] = "Classified"
			)
		formatString: 0
		lineageTag: 00d7f40c-efe0-41f6-85cb-6ef7cebfa141

	measure 'Sensitive Columns' =
			
			DISTINCTCOUNT (
			    classification_report[ColumnKey]
			)
		formatString: 0
		lineageTag: 6ec41f11-2136-41bd-ac38-369694a15fef

	measure 'Sensitive Elements Found' =
			
			CALCULATE (
