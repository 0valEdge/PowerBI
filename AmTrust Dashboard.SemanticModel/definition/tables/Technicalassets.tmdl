	measure 'Scan Recency Ratio' = ```
			
			VAR MaxDays = 45
			VAR CurrentDays = MAX ( connector_scan_health[days_since_last_scan] )
			RETURN
			DIVIDE ( MIN ( CurrentDays, MaxDays ), MaxDays )
			
			```
		lineageTag: a724e8bf-c13b-4add-afde-984afe7022d2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Scan Status Colour' =
			
			SWITCH (
			    SELECTEDVALUE ( connector_scan_health[scan_status] ),
			    "Healthy",        "#2E7D32",
			    "Overdue",        "#E07B0A",
			    "Stale",          "#C0392B",
			    "Never Scanned",  "#7F8C8D",
			    "#7F8C8D"
			)
		lineageTag: 070b427f-68c8-4aa0-9d98-90cedeee9f26

