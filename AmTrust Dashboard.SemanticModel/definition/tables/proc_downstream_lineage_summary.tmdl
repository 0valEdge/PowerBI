table proc_downstream_lineage_summary
	lineageTag: 595e3e7d-cfea-4f81-abc7-205812ed501b

	measure 'Importance Cell' =
			
			VAR v = [Importance Value]
			VAR pct = MIN ( 1, DIVIDE ( v, 100 ) )
			RETURN
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='20'>"
			& "<rect y='7' width='80' height='6' rx='3' fill='%23E5E7EB'/>"
			& "<rect y='7' width='" & MAX ( 3, ROUND ( 80 * pct, 0 ) ) & "' height='6' rx='3' fill='%231D6FB8'/>"
			& "<text x='92' y='15' font-size='18' font-weight='bold' fill='%23111827' font-family='Arial, sans-serif'>"
			& ROUND ( v, 0 ) & "</text></svg>"
		lineageTag: e470909a-3a65-452c-bd53-57ece9460628
		dataCategory: ImageUrl

	measure 'Importance Value' =
			
			COALESCE ( MAX ( proc_downstream_lineage_summary[Importance] ), 0 )
		formatString: 0
		lineageTag: de647c18-96a1-4ff6-89d8-276726913c1d

