		annotation SummarizationSetBy = Automatic

	column status_chip(html) =
			
			VAR status_chip = dsar_dashboard_summary[status_chip]
			
			VAR BackgroundColor =
			    SWITCH(
			        status_chip,
			        "In progress", "#FFF1CC",
			        "Closed", "#DDF5F5",
			        "Overdue", "#FFE1E1",
			        "#FFFFFF"
			    )
			
			VAR TextColor =
			    SWITCH(
			        status_chip,
			        "In progress", "#A66A00",
			        "Closed", "#008C8C",
			        "Overdue", "#C62828",
			        "#333333"
			    )
			
			RETURN
			"data:image/svg+xml;utf8," &
			"<svg xmlns='http://www.w3.org/2000/svg' width='130' height='40'>" &
			"<rect x='5' y='5' width='120' height='30' rx='15' fill='" &
			BackgroundColor &
			"'/>" &
			"<text x='65' y='25' text-anchor='middle' " &
			"font-family='Segoe UI' font-size='15' font-weight='600' fill='" &
			TextColor &
			"'>" &
			status_chip &
			"</text>" &
			"</svg>"
		lineageTag: e1dd9e45-f5d4-4741-88b2-e8d3846f3478
		dataCategory: ImageUrl
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dsar_dashboard_summary = m
		mode: import
		source =
				let
				    Source = MySQL.Database(Host, Database, [ReturnSingleDatabase=true]),
				    ovaledgedb_dsar_dashboard_summary = Source{[Schema="ovaledgedb",Item="dsar_dashboard_summary"]}[Data]
				in
				    ovaledgedb_dsar_dashboard_summary

