	column 'Change Badge' =
			
			VAR ChangeValue = Metadata_change_log[CHANGE_TYPE]
			
			VAR BackgroundColor =
			    SWITCH(
			        ChangeValue,
			        "Modified", "#FFF1CC",
			        "Added", "#DDF5F5",
			        "Removed", "#FFE1E1",
			        "#FFFFFF"
			    )
			
			VAR TextColor =
			    SWITCH(
			        ChangeValue,
			        "Modified", "#A66A00",
			        "Added", "#008C8C",
			        "Removed", "#C62828",
			        "#333333"
			    )
			
			RETURN
			"data:image/svg+xml;utf8," &
			"<svg xmlns='http://www.w3.org/2000/svg' width='130' height='40'>" &
			"<rect x='5' y='5' width='120' height='30' rx='15' fill='" &
			BackgroundColor &
			"'/>" &
			"<text x='65' y='25' text-anchor='middle' " &
			"font-family='Segoe UI' font-size='15' font-weight='600' fill='" &
			TextColor &
			"'>" &
			ChangeValue &
			"</text>" &
			"</svg>"
		lineageTag: d1f6ac16-4169-46d7-aea4-1b583ddb8cab
		dataCategory: ImageUrl
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Latest 2 Scan Cycles' = ```
			
			VAR LatestScan =
			    CALCULATE (
			        MAX ( METADATA_CHANGE_LOG[SCAN_DATE] ),
			        ALL ( METADATA_CHANGE_LOG )
			    )
			
			VAR PreviousScan =
			    CALCULATE (
			        MAX ( METADATA_CHANGE_LOG[SCAN_DATE] ),
			        FILTER (
			            ALL ( METADATA_CHANGE_LOG ),
			            METADATA_CHANGE_LOG[SCAN_DATE] < LatestScan
			        )
			    )
			
			RETURN
			    IF (
			        METADATA_CHANGE_LOG[SCAN_DATE] = LatestScan
			            || METADATA_CHANGE_LOG[SCAN_DATE] = PreviousScan,
			        1,
			        0
			    )
			
			```
		formatString: 0
		lineageTag: 04b7c91a-acf6-4b6e-bb33-7445c7b58f91
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

