table Metadata_change_log
	lineageTag: 049955a2-8d86-43be-ad98-79bea39a1988

	measure Added =
			
			VAR LatestScan =
			    CALCULATE (
			        MAX ( METADATA_CHANGE_LOG[SCAN_DATE] ),
			        ALL ( METADATA_CHANGE_LOG )
			    )
			RETURN
			    CALCULATE (
			        COUNTROWS ( METADATA_CHANGE_LOG ),
			        METADATA_CHANGE_LOG[SCAN_DATE] = LatestScan,
			        METADATA_CHANGE_LOG[CHANGE_TYPE] = "Added"
			    )
		formatString: 0
		lineageTag: 2d2c6cd3-7042-47de-a401-464aa7005055

	measure 'Added Changes' =
			
			CALCULATE (
			    COUNTROWS ( METADATA_CHANGE_LOG ),
			    KEEPFILTERS (
			        METADATA_CHANGE_LOG[CHANGE_TYPE] = "Added"
			    )
			)
		formatString: 0
		lineageTag: af9fd1d7-5bf2-48ce-83da-4d7c85ca0e9f

	measure 'CDE Flagged Changes' =
			
			VAR LatestScan =
			    CALCULATE (
			        MAX ( METADATA_CHANGE_LOG[SCAN_DATE] ),
			        ALL ( METADATA_CHANGE_LOG )
			    )
			RETURN
			    CALCULATE (
			        COUNTROWS ( METADATA_CHANGE_LOG ),
			        METADATA_CHANGE_LOG[SCAN_DATE] = LatestScan,
			        METADATA_CHANGE_LOG[IS_CDE] = "Yes"
			    )
		formatString: 0
		lineageTag: 662b2a8b-c716-46c4-a1dc-3a4f86ac48be

	measure 'CDE Flagged Changes(detailed View)' =
			
			CALCULATE (
			    COUNTROWS ( METADATA_CHANGE_LOG ),
			    METADATA_CHANGE_LOG[IS_CDE] = "Yes"
			)
		formatString: 0
		lineageTag: c375c760-b378-45db-a49e-fa87451e07d3

	measure 'CDE Impacted' =
			
			VAR CDECount =
			    CALCULATE (
			        COUNTROWS ( METADATA_CHANGE_LOG ),
			        METADATA_CHANGE_LOG[IS_CDE] = "Yes"
			    )
			RETURN
			    IF ( CDECount > 0, "Yes", "No" )
		lineageTag: cafc9457-3c0b-4ac0-bb09-60358952bad2

	measure 'CDE-flagged / downstream impacted' = [CDE Flagged Changes(detailed View)] & " / " & [Downstream Assets Impacted(detailed View)]
		lineageTag: d88491ce-bcdd-44f1-8a29-9bb30b7e3730

	measure 'Downstream Assets Impacted' =
			
			VAR LatestScan =
			    CALCULATE (
			        MAX ( METADATA_CHANGE_LOG[SCAN_DATE] ),
			        ALL ( METADATA_CHANGE_LOG )
			    )
			RETURN
			    CALCULATE (
			        SUM ( METADATA_CHANGE_LOG[DOWNSTREAM_ASSETS_COUNT] ),
			        METADATA_CHANGE_LOG[SCAN_DATE] = LatestScan
			    )
		formatString: 0
		lineageTag: c5e31729-1bcc-4a3f-8ba5-fa2cb31f3cee

	measure 'Downstream Assets Impacted(detailed View)' =
			
			SUMX (
			    METADATA_CHANGE_LOG,
			    COALESCE (
			        METADATA_CHANGE_LOG[DOWNSTREAM_ASSETS_COUNT],
			        0
			    )
			)
		formatString: 0
		lineageTag: 9945000d-b5bc-4e76-9e59-c44cf9541902

	measure 'Changes in Source' =
			
			COUNTROWS ( METADATA_CHANGE_LOG )
		formatString: 0
		lineageTag: 077aaa8d-c805-42b1-9ee7-0d1ffed3776f

	measure 'Changes Since Last Scan' =
			
			VAR LatestScan =
			    CALCULATE (
			        MAX ( METADATA_CHANGE_LOG[SCAN_DATE] ),
			        ALL ( METADATA_CHANGE_LOG )
			    )
			VAR PreviousScan =
			    CALCULATE (
			        MAX ( Metadata_change_log[LAST_SCAN_DATE] ),
			            ALL ( METADATA_CHANGE_LOG )
			        )
			RETURN
			    "Changes between "
			        & FORMAT ( PreviousScan, "dd-MMM-yyyy" )
			        & " and "
			        & FORMAT ( LatestScan, "dd-MMM-yyyy" )
		lineageTag: d3f24cb7-e519-499b-93c2-8e8f42f58331

	measure Label = "Showing: " & SELECTEDVALUE(Metadata_change_log[DATA_SOURCE])
		lineageTag: aabb95eb-013c-4cdf-a918-d4e904884564

	measure 'Latest Scan' =
			
			VAR LatestScanDate =
			    CALCULATE (
			        MAX ( METADATA_CHANGE_LOG[SCAN_DATE] ),
			        ALL ( METADATA_CHANGE_LOG )
			    )
			RETURN
			    IF (
			        MAX ( METADATA_CHANGE_LOG[SCAN_DATE] ) = LatestScanDate,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 23ba46eb-5ec7-4949-a867-321c2410a239

	measure Modified =
			
			VAR LatestScan =
			    CALCULATE (
			        MAX ( METADATA_CHANGE_LOG[SCAN_DATE] ),
			        ALL ( METADATA_CHANGE_LOG )
			    )
			RETURN
			    CALCULATE (
			        COUNTROWS ( METADATA_CHANGE_LOG ),
			        METADATA_CHANGE_LOG[SCAN_DATE] = LatestScan,
			        METADATA_CHANGE_LOG[CHANGE_TYPE] = "Modified"
			    )
		formatString: 0
		lineageTag: bed89f8f-6bba-449e-ade9-082b6ed49828

	measure 'Modified Changes' =
			
			CALCULATE (
			    COUNTROWS ( METADATA_CHANGE_LOG ),
			    KEEPFILTERS (
			        METADATA_CHANGE_LOG[CHANGE_TYPE] = "Modified"
			    )
			)
		formatString: 0
		lineageTag: cbba1ed8-1f02-42e7-aceb-b90190fd791e

	measure Removed =
			
			VAR LatestScan =
			    CALCULATE (
			        MAX ( METADATA_CHANGE_LOG[SCAN_DATE] ),
			        ALL ( METADATA_CHANGE_LOG )
			    )
			RETURN
			    CALCULATE (
			        COUNTROWS ( METADATA_CHANGE_LOG ),
			        METADATA_CHANGE_LOG[SCAN_DATE] = LatestScan,
			        METADATA_CHANGE_LOG[CHANGE_TYPE] = "Removed"
			    )
		formatString: 0
		lineageTag: 4d6535b9-bc79-4cd5-98bb-675f2bb9b78c

	measure 'Removed Changes' =
			
			CALCULATE (
			    COUNTROWS ( METADATA_CHANGE_LOG ),
			    KEEPFILTERS (
			        METADATA_CHANGE_LOG[CHANGE_TYPE] = "Removed"
			    )
			)
		formatString: 0
		lineageTag: 4a4cc5c0-1995-4e9d-9a63-b21dbc3c351a

	measure 'Sources Changed' =
			
			VAR MaxLastScanDate =
			    CALCULATE (
			        MAX ( METADATA_CHANGE_LOG[LAST_SCAN_DATE] ),
			        ALL ( METADATA_CHANGE_LOG )
			    )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( METADATA_CHANGE_LOG[DATA_SOURCE] ),
			        METADATA_CHANGE_LOG[CHANGE_DATE] > MaxLastScanDate
			    )
		formatString: 0
		lineageTag: fc1d476e-5c0d-4d24-8754-e535e081762a

	measure 'Sources Scanned' =
			
			DISTINCTCOUNT ( METADATA_CHANGE_LOG[DATA_SOURCE] )
		formatString: 0
		lineageTag: 37ed3cb7-e45d-4484-b5f6-b638d85c6ebb

	measure 'Total Changes Detected' =
			
			VAR LatestScan =
			    CALCULATE (
			        MAX ( METADATA_CHANGE_LOG[SCAN_DATE] ),
			        ALL ( METADATA_CHANGE_LOG )
			    )
			RETURN
			    CALCULATE (
			        COUNTROWS ( METADATA_CHANGE_LOG ),
			        METADATA_CHANGE_LOG[SCAN_DATE] = LatestScan
			    )
		formatString: 0
		lineageTag: 0e23657d-95ea-4874-a1af-f777b2a74ada

